symbolPreset: nerd
composer:
  shape: band
theme:
  light: light-catppuccin
  dark: dark-catppuccin
setupVersion: 2
modelRoles:
  default: arm-base/deepseek-v4.1-flash:high
  review: arm-base/deepseek-v4.1-flash:max
  tiny: arm-base/deepseek-v4.1-flash:auto
  smol: arm-base/deepseek-v4.1-flash:high
  plan: arm-base/deepseek-v4.1-flash:max
  vision: arm-base/deepseek-v4.1-flash:auto
memory:
  backend: mnemopi
mnemopi:
  scoping: global
  llmMode: smol
autolearn:
  enabled: true
  autoContinue: true
providers:
  memoryModel: online
edit:
  mode: hashline
hideThinkingBlock: true
startup:
  checkUpdate: {{ if .internet_access }}true{{ else }}false{{ end }}
marketplace:
  autoUpdate: {{ if .internet_access }}notify{{ else }}off{{ end }}
