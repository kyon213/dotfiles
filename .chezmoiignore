# ==============================================================================
# Chezmoi Ignore Registry
# Files matching these patterns stay in the repo and won't deploy to $HOME.
# ==============================================================================

# Repository Metadata & Licensing
README.md
LICENSE

# tpm plugin .git dirs carry clone identity in logs; never track them.
dot_tmux/plugins/**/dot_git/**

# Package manager lock files or local development notes
*.log

# Local configuration files
.config/chezmoi/

.config/fish/completions/
.config/fish/conf.d/
.config/fish/fish_variables

.config/mihoro.toml
.config/mihomo/

# In shared-deployment mode the mise config lives on the shared disk
# (rendered by run_onchange_after_mise.sh.tmpl); skip the redundant home copy.
{{ if .dotfiles_base }}
.config/mise/config.toml
{{ end }}

.config/nvim/lazy-lock.json

.config/systemd/

# .login is csh-specific; deploy only on csh-family login shells.
{{ $shell := output "sh" "-c" "getent passwd \"$(id -u)\" | cut -d: -f7" }}
{{ if not ($shell | contains "csh") }}
.login
{{ end }}

# LLVM research build configuration is only deployed to heavy workstations.
{{ if not .is_heavy_workstation }}
.config/llvm/
{{ end }}
