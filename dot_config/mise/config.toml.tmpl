# Versioned mise tool list (chezmoi-managed; replaces the former Brewfile).
# Deployed to ~/.config/mise/config.toml (per-machine) or rendered onto the
# shared disk in shared-deployment mode (see run_onchange_after_mise.sh.tmpl).
[tools]
# ---- Shell & terminal ----
"github:fish-shell/fish-shell" = "latest"
tmux = "latest"
neovim = "latest"
bat = "latest"
eza = "latest"
fzf = "latest"
fd = "latest"
ripgrep = "latest"
zoxide = "latest"
lazygit = "latest"

# ---- Monitoring ----
btop = "latest"

# ---- Languages & runtimes ----
node = "latest"
stylua = "latest"

# ---- Build toolchain ----
cmake = "latest"
ninja = "latest"
ccache = "latest"

# ---- LSP servers ----
"github:clangd/clangd" = "latest"
lua-language-server = "latest"
marksman = "latest"

# ---- Formatting & linting ----
prettier = "latest"
markdownlint-cli2 = "latest"
# shfmt = static Go binary (glibc-safe); markdown-toc has no mise registry entry -> npm backend.
"aqua:mvdan/sh" = "latest"
"npm:markdown-toc" = "latest"

# ---- Neovim (tree-sitter CLI) ----
# glibc-aware pin: GitHub binaries >=0.25 need glibc>=2.39 (Ubuntu 24.04 build);
# older hosts (e.g. glibc 2.34) get the last compatible release instead.
# LazyVim compiles treesitter parsers with this CLI; a broken CLI => "Installed 0/N".
# NOTE: output() appends a trailing newline, so the regex must not anchor on $.
{{ $glibc := output "getconf" "GNU_LIBC_VERSION" }}
"aqua:tree-sitter/tree-sitter" = "{{ if $glibc | regexMatch "^glibc (2\\.(39|[4-9][0-9])|[3-9]\\.|[1-9][0-9]\\.)" }}latest{{ else }}0.24.3{{ end }}"

# ---- AI agent harness ----
oh-my-pi = { version = "latest", rename_exe = "omp" }

# ---- Tool manager ----
chezmoi = "latest"

{{- if not (output "bash" "-c" "git help worktree >/dev/null 2>&1 && echo ok") }}
# ---- Git (capability probe: system git lacks worktree) ----
git = "latest"
{{- end }}

{{ if .is_heavy_workstation }}
# ---- Heavy workstation extras (LLVM builds) ----
mold = "latest"
clang = "latest"
clang-format = "latest"
{{ end }}

{{ if eq (get . "environment") "personal" }}
# ---- Blog debugging (personal machines) ----
gh = "latest"
hugo = "latest"
{{ end }}
