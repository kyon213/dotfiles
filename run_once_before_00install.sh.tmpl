#!/bin/bash
# ==============================================================================
# Prerequisites: mise presence + system-software state gate.
# Tool installation happens in run_onchange_after_mise.sh.tmpl.
# ==============================================================================
{{ if .dotfiles_base }}
MISE_BIN={{ .dotfiles_base }}/.local/bin/mise
{{ else }}
MISE_BIN="$HOME/.local/bin/mise"
{{ end }}

# 1. mise presence (checked regardless of network; shared machines also check
#    the shared-disk binary, which may not be on PATH in this shell).
if ! command -v mise >/dev/null 2>&1 && [ ! -x "$MISE_BIN" ]; then
  {{ if not .internet_access }}
  echo "mise not found and no internet access; install mise first (see README Prerequisites)"
  exit 1
  {{ else }}
  echo "mise not found; installing it now..."
  curl -fsSL https://mise.run | {{ if .dotfiles_base }}MISE_INSTALL_PATH={{ .dotfiles_base }}/.local/bin/mise sh{{ else }}sh{{ end }}
  [ -x "$MISE_BIN" ] || { echo "mise auto-install failed; install it manually (see README Prerequisites)"; exit 1; }
  {{ end }}
fi

# 2. System-software courtesy gate (online install flow only)
{{ if .internet_access }}
if [ -t 0 ]; then
  read -r -p "Is your system software up to date? (y = yes/cannot update, continue; n = update first, then re-apply) [Y/n] " ans
  case "${ans:-y}" in
    n|N)
      echo "Please update system software (e.g. apt update && apt upgrade), then run 'chezmoi apply' again."
      exit 1
      ;;
  esac
else
  echo "Non-interactive run: skipping system-update question."
fi
{{ end }}
