[user]
  name = {{ .git_name }}
  email = {{ .git_email }}
[include]
  path = ~/.config/git/gitalias.txt
  path = ~/.config/git/catppuccin-delta.gitconfig
[init]
  defaultBranch = main
[core]
  editor = nvim
  pager = delta
  quotepath = false
[branch]
  sort = -committerdate
[diff]
  tool = nvimdiff
  algorithm = histogram
  colorMoved = default
[difftool]
  prompt = false
[difftool "nvimdiff"]
  cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[fetch]
  prune = true
[help]
  autocorrect = prompt
[interactive]
  diffFilter = delta --color-only
  singleKey = true
[merge]
  conflictStyle = zdiff3
[pull]
  rebase = true
[rerere]
  enabled = true
[delta]
  features = catppuccin-latte
  navigate = true
  line-numbers = true
[i18n "commit"]
  encoding = utf-8
[i18n]
  logoutputencoding = utf-8
